# ---------------------------------------------------------------------------
# Private settings: never commit these
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# Generated from .env by scripts/env.js (contains the same private values)
src/js/config/env.js

# Generated from BlogSpeed by scripts/blog.js (rebuilt on every build)
src/js/config/blog-data.js

# ---------------------------------------------------------------------------
# Build output (recreate with: npm run build)
# ---------------------------------------------------------------------------
dist/

# ---------------------------------------------------------------------------
# Dependencies, logs, editor and OS files
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Downloaded photos (rebuilt by npm run build)
.cache/
