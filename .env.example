# ---------------------------------------------------------------------------
# V Soccer School: private settings
#
# 1. Copy this file to .env        (Windows: copy .env.example .env)
# 2. Fill in the values below
# 3. Run npm start
#
# .env is listed in .gitignore, so your real details never reach Git.
# ---------------------------------------------------------------------------

# Inbox that receives every trial request, message and newsletter sign-up.
# Also shown on the Contact page.
SCHOOL_EMAIL=you@example.com

# Optional: web-app URL of the Google Apps Script that WhatsApps every
# request to the school (README > WhatsApp setup). The phone number itself
# is stored in that script, never here or on the site.
SCHOOL_WHATSAPP_RELAY=

# Optional: WhatsApp number (include +91) that the "Chat on WhatsApp"
# button opens. The number isn't printed on the page, but it is part of the
# button's link, so anyone who taps it sees it in WhatsApp.
SCHOOL_WHATSAPP_CHAT=

# Optional: full Instagram link
SCHOOL_INSTAGRAM=
