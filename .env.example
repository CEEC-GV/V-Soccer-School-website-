# ---------------------------------------------------------------------------
# V Soccer School: private settings
#
# 1. Copy this file to .env        (Windows: copy .env.example .env)
# 2. Fill in the values below
# 3. Run npm start
#
# .env is listed in .gitignore, so your real details never reach Git.
# ---------------------------------------------------------------------------

# Inbox that receives every trial request, message and newsletter sign-up.
# After activating FormSubmit you can use the alias it emails you instead.
SCHOOL_EMAIL=you@example.com

# Optional: turns on the Call and WhatsApp buttons (include +91)
SCHOOL_PHONE=

# Optional: full Instagram link
SCHOOL_INSTAGRAM=
